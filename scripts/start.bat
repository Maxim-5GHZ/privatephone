@echo off
rem «ПриватФон» — запуск узла двойным кликом (Windows).
rem Мастер-ключ должен находиться на USB-флешке (пустая флешка подойдёт —
rem ключ создастся на ней автоматически).
cd /d "%~dp0"
pp.exe run
if errorlevel 1 (
  echo.
  echo Ошибка запуска. Проверьте, что USB-флешка вставлена и смонтирована.
  pause
)